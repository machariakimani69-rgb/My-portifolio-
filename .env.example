PORT=3000
NODE_ENV=development
HOST=0.0.0.0

# Admin authentication — set ONE of these, not both.
# ADMIN_PASSWORD: plaintext password (≥12 chars, ≤72 UTF-8 bytes). Server hashes it on first start.
# ADMIN_PASSWORD_HASH: bcrypt hash if you pre-hash the password yourself.
ADMIN_PASSWORD=replace-with-a-long-unique-password
# ADMIN_PASSWORD_HASH=

# Optional: enables admin password recovery via the sign-in page.
# Generate: [Convert]::ToBase64String((1..48 | % { [byte](Get-Random -Max 256) })) in PowerShell.
# ADMIN_RECOVERY_KEY=replace-with-at-least-32-random-characters

# Session signing key — must be at least 32 random characters.
# Generate: [Convert]::ToBase64String((1..48 | % { [byte](Get-Random -Max 256) })) in PowerShell.
SESSION_SECRET=replace-with-at-least-64-random-characters

# Turso/libSQL — required for production (Render).
# Leave blank to use local SQLite in development.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Cross-origin frontend URL(s) — comma-separated HTTPS origins allowed to call the API.
# Example: https://my-portfolio.onrender.com
# Leave blank when the frontend and backend are on the same origin.
CORS_ALLOWED_ORIGINS=